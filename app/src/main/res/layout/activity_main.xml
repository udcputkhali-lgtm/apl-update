<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡"
                android:textSize="28sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IVAC ডুয়াল-সিম ওটিপি"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvServiceStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="সার্ভিস স্ট্যাটাস: শুরু হচ্ছে..."
                    android:textColor="#10B981"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:padding="12dp"
            android:text="💡 সিম ১ এ ওটিপি আসলে এক্সটেনশন ১ এ যাবে, আর সিম ২ এ আসলে এক্সটেনশন ২ এ যাবে। নিচে প্রতিটি সিমের মোবাইল নম্বর লিখে সেভ করুন।"
            android:textColor="#CBD5E1"
            android:textSize="12sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="12dp"
            app:strokeColor="#334155"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvSim1Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📶 সিম ১ (স্লট ১)"
                    android:textColor="#38BDF8"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="পিসি-১ এর এক্সটেনশনে ব্যবহৃত মোবাইল নম্বর:"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etSim1Phone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="#0F172A"
                    android:hint="017XXXXXXXX"
                    android:inputType="phone"
                    android:paddingHorizontal="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="12dp"
            app:strokeColor="#334155"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvSim2Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📶 সিম ২ (স্লট ২)"
                    android:textColor="#F59E0B"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="পিসি-২ এর এক্সটেনশনে ব্যবহৃত মোবাইল নম্বর:"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etSim2Phone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="#0F172A"
                    android:hint="019XXXXXXXX"
                    android:inputType="phone"
                    android:paddingHorizontal="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#10B981"
            android:text="💾 নম্বর সংরক্ষণ করুন (Save)"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#172554"
            app:cardCornerRadius="12dp"
            app:strokeColor="#1E40AF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔋 ব্যাকগ্রাউন্ড ওটিপি গতি (Battery Saver Off)"
                    android:textColor="#93C5FD"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="স্ক্রিন অফ থাকলেও তৎক্ষণাৎ ১ সেকেন্ডে ওটিপি পেতে ব্যাটারি অপ্টিমাইজেশন বন্ধ রাখুন।"
                    android:textColor="#BFDBFE"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnRequestBattery"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:text="⚡ Unrestricted Battery পারমিশন দিন"
                    android:textColor="#93C5FD"
                    android:textSize="12sp"
                    app:strokeColor="#60A5FA" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Live IVAC Activity Monitor Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#0B132B"
            app:cardCornerRadius="12dp"
            app:strokeColor="#0EA5E9"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📊 লাইভ IVAC স্ট্যাটাস মনিটর"
                        android:textColor="#38BDF8"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLiveIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#1E293B"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="🟢 LIVE"
                        android:textColor="#34D399"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="লগইন, ফাইল আপলোড, স্লট রিলিজ ও পেমেন্টের লাইভ আপডেট সরাসরি এখানে দেখা যাবে:"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <!-- Container for dynamic activity cards -->
                <LinearLayout
                    android:id="@+id/llActivityContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNoActivityPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#0F172A"
                        android:padding="12dp"
                        android:text="⏳ ব্রাউজারে এক্সটেনশন চালু হলে লাইভ স্ট্যাটাস আপডেট এখানে স্বয়ংক্রিয়ভাবে প্রদর্শিত হবে..."
                        android:textColor="#64748B"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
